{
  "name": "activity-ranking-api-acceptance-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-first BDD acceptance suite for the Activity Ranking API (Playwright + playwright-bdd + WireMock + Allure).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=acceptance",
    "test:smoke": "bddgen && playwright test --project=acceptance --grep @smoke",
    "test:live": "bddgen && playwright test --project=live-weather-provider",
    "test:docker": "docker compose up --build --abort-on-container-exit --exit-code-from acceptance-tests",
    "stubs:start": "docker compose up --detach weather-provider-stub",
    "stubs:stop": "docker compose down",
    "contract:types": "openapi-typescript contract/activity-ranking-api.openapi.yaml --output src/contract/generated/activity-ranking-api.ts && prettier --write src/contract/generated",
    "contract:lint": "redocly lint contract/activity-ranking-api.openapi.yaml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run contract:lint && bddgen",
    "report:allure": "allure generate allure-results --output allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.63.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "openapi-typescript": "7.13.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
